# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# 이 과제는 "별도 제공되는 key는 없으며 개인 계정으로 구현" 전제라, 개발용
# credentials.yml.enc는 각자 bin/rails credentials:edit로 자기 키로
# 새로 만드는 게 맞음 — 그래서 (Rails 기본 관례와 달리) 암호화된 파일도
# 커밋하지 않음. 이걸 커밋해두면, 클론한 사람이 자기 master.key로
# credentials:edit을 실행할 때 이미 있는(내 개인 키로 암호화된) enc 파일을
# 못 열어서 "Couldn't decrypt..." 에러가 나고 앱 자체가 부팅이 안 되는
# 문제가 있었음(2026-07-31 확인). enc 파일이 아예 없어야
# credentials:edit이 master.key+enc 파일을 새로 만들어줌.
/config/credentials.yml.enc

# Ignore key files for decrypting credentials and more — 단, test.key는
# 예외로 커밋함. config/credentials/test.yml.enc는 openai_api_key를 일부러
# 비워둔 파일이라(테스트가 "키 없음 → 502" 경로를 결정적으로 검증하기
# 위함, README 6.1 참고) 이 키가 노출돼도 실질적인 위험이 없고, 오히려
# 이게 없으면 클론 직후 bundle exec rspec 자체가 부팅 실패로 못 돌아감
# (2026-07-31 확인). production.key 등 다른 env 키는 계속 제외됨.
/config/credentials/*.key
!/config/credentials/test.key
